      "def": "CHECK ((event_type = ANY (ARRAY['view'::text, 'click'::text, 'conversion'::text])))"
    },
    {
      "t": "affiliate_clicks",
      "conname": "affiliate_clicks_partner_check",
      "k": "c",
      "def": "CHECK ((partner = ANY (ARRAY['viator'::text, 'booking'::text, 'getyourguide'::text, 'klook'::text])))"
    },
    {
