    },
    {
      "t": "guide_earnings",
      "conname": "guide_earnings_status_check",
      "k": "c",
      "def": "CHECK ((status = ANY (ARRAY['calculated'::text, 'approved'::text, 'processing'::text, 'paid'::text, 'failed'::text, 'below_minimum'::text])))"
    },
    {
      "t": "guide_profiles",
