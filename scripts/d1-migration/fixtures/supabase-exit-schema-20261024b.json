      "conname": "content_engagement_content_type_check",
      "k": "c",
      "def": "CHECK ((content_type = ANY (ARRAY['itinerary_view'::text, 'itinerary_save'::text, 'spot_view'::text, 'spot_save'::text])))"
    },
    {
      "t": "content_engagement",
      "conname": "content_engagement_pkey",
      "k": "p",
      "def": "PRIMARY KEY (id)"
