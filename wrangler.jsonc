// Localley Next.js app on Cloudflare Workers through OpenNext (@opennextjs/cloudflare).
// Path B, chosen by Nils on 2026-09-23. See docs/CLOUDFLARE_OPENNEXT.md.
//
// Top level = NON-PRODUCTION preview Worker `localley-next-preview` (workers.dev).
//   Deploy: npm run cf:deploy:preview
// env.production = production Worker `localley-next`. No workers.dev URL. Until the
//   DNS switch (P7) its only host is the staging domain next.localley.io, and its
//   Cron Triggers stay off until P8 (docs/CLOUDFLARE_OPENNEXT.md section 6).
//
// Secrets are never stored here. Preview secrets are set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localley-next-preview",
  "account_id": "664f242340bcec2f32daaeee15f58bde",
  "main": "cloudflare/opennext/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "limits": { "cpu_ms": 30000 },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  // Worker version id keys the public HTML edge cache (cloudflare/opennext/edge-html-cache.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "localley-next-preview" },
    // Normal preview reads only the existing public review projection. No Source secret.
    { "binding": "PUBLIC_REVIEW_SOURCE", "service": "localley-next" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "localley-next-preview-cache" },
    { "binding": "STORY_PREVIEW_MEDIA", "bucket_name": "localley-story-preview-media", "jurisdiction": "eu" }
  ],
  "d1_databases": [{
    // Shared preview/production reference quota; never application or auth data.
    "binding": "NAVER_REFERENCE_DB",
    "database_name": "localley-reference-cache",
    "database_id": "44b8b59c-a44d-4b42-ac03-40508c3eee89",
    "migrations_dir": "migrations/references"
  }, {
    "binding": "NEXT_TAG_CACHE_D1",
    "database_name": "localley-next-preview-tags",
    "database_id": "d0abdd88-2dc4-47c1-a40e-14b0dcb64e30"
  }, {
    // Better Auth store for the PREVIEW only (users, sessions, test mailbox). Never production data.
    // Agents may create test users here freely (docs/AUTH_BETTER_AUTH.md).
    "binding": "AUTH_DB",
    "database_name": "localley-auth-preview",
    "database_id": "58b7eef4-2e41-4408-9246-36bc22988200",
    "migrations_dir": "migrations/auth"
  }, {
    // Isolated application-data candidate with the verified September 30 source import.
    // Production still uses Supabase. Keep the old pilot D1 for preview rollback.
    "binding": "APP_DATA_PREVIEW_DB",
    "database_name": "localley-migration-candidate-20260930",
    "database_id": "6f5b1df7-2eb5-479f-8803-8095e72c7053",
    "migrations_dir": "migrations/app-preview"
  }],
  // lib/rate-limit.ts uses RATE_LIMIT_<maxRequests> for 60 second windows (replaces Upstash).
  "ratelimits": [
    { "name": "RATE_LIMIT_5", "namespace_id": "4301", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMIT_10", "namespace_id": "4302", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_20", "namespace_id": "4303", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_60", "namespace_id": "4304", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_40", "namespace_id": "4305", "simple": { "limit": 40, "period": 60 } },
    { "name": "RATE_LIMIT_120", "namespace_id": "4306", "simple": { "limit": 120, "period": 60 } }
  ],
  // The preview points at production Supabase with the public anon key only.
  // SUPABASE_READ_ONLY blocks every non-GET Supabase request (lib/supabase-read-only.ts).
  "vars": {
    // The existing explicit preview candidate retains its separate store.
    "AUTH_NOTIFICATION_STORAGE": "off",
    "SUPABASE_READ_ONLY": "true",
    "NEXTJS_ENV": "production",
    // Auth emails go to the auth_mail_outbox table, never to a real inbox.
    "AUTH_MAIL_MODE": "outbox",
    // OpenNext bundles private build defaults. Override local development tier
    // flags explicitly so hosted candidate acceptance uses saved entitlements.
    "BETA_MODE": "false",
    "BYPASS_IMAGE_TIER_CHECK": "false",
    "PREVIEW_STORY_GENERATION_ENABLED": "false",
    "PREVIEW_CHAT_GENERATION": "false",
    // Synthetic signed preview event fixtures only. Real test checkout remains gated.
    "PREVIEW_STRIPE_PRICE_TIERS": "{\"price_localley_preview_pro\":\"pro\",\"price_localley_preview_premium\":\"premium\"}",
    "BETTER_AUTH_URL": "https://localley-next-preview.nkopp.workers.dev",
    "AUTH_ALLOWED_HOSTS": "localley-next-preview.nkopp.workers.dev",
    "ADMIN_USER_IDS": "user_38VRkLQbwVNbAqR9lBXTMGXr54h,eRrDwrrwjwO1YsxVlci7M6mMjjqPtyYx"
  },
  // No Cron Triggers on the preview: the jobs write data. Test them with
  // `npm run cf:preview:local` and /cdn-cgi/handler/scheduled (see the docs).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "env": {
    "production": {
      "name": "localley-next",
      "workers_dev": false,
      "preview_urls": false,
      "limits": { "cpu_ms": 30000 },
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "send_email": [{ "name": "AUTH_EMAIL", "allowed_sender_addresses": ["hello@localley.io"] }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "localley-next" }],
      // Created 2026-09-23 (step P2, approved by Nils).
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "localley-next-cache" },
        // Story media step 1 (Nils 2026-10-23 "R2 media path"; shared/plans/localley-decisions.md):
        // server-side reads of archived story backgrounds (legacy/<sha256>.<ext>). No public route.
        { "binding": "STORY_MEDIA_R2", "bucket_name": "localley-legacy-media", "jurisdiction": "eu" }
      ],
      "d1_databases": [{
        "binding": "NAVER_REFERENCE_DB",
        "database_name": "localley-reference-cache",
        "database_id": "44b8b59c-a44d-4b42-ac03-40508c3eee89",
        "migrations_dir": "migrations/references"
      }, {
        "binding": "NEXT_TAG_CACHE_D1",
        "database_name": "localley-next-tags",
        "database_id": "ca1dc3b6-b8cc-49a6-b299-f5d1965cf18c"
      }, {
        // Production Better Auth store (users, sessions). Created 2026-09-23 (step A1,
        // approved by Nils "go ahead"). Migrations: migrations/auth, applied --env production --remote.
        "binding": "AUTH_DB",
        "database_name": "localley-auth",
        "database_id": "73378d0e-7f2a-465a-8188-a67cb6d2a5c2",
        "migrations_dir": "migrations/auth"
      }, {
        // Supabase exit (shared/plans/localley-supabase-exit.md, approved 2026-10-24): application data.
        // Serving store since 2026-10-25 (DATA_BACKEND=d1 below; lib/app-data/backend.ts).
        "binding": "APP_DB",
        "database_name": "localley-app",
        "database_id": "f1cc916b-5606-443f-9c4f-695c4ccc4a63",
        "migrations_dir": "migrations/app-preview"
      }],
      "ratelimits": [
        { "name": "RATE_LIMIT_5", "namespace_id": "4311", "simple": { "limit": 5, "period": 60 } },
        { "name": "RATE_LIMIT_10", "namespace_id": "4312", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_20", "namespace_id": "4313", "simple": { "limit": 20, "period": 60 } },
        { "name": "RATE_LIMIT_60", "namespace_id": "4314", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMIT_40", "namespace_id": "4315", "simple": { "limit": 40, "period": 60 } },
        { "name": "RATE_LIMIT_120", "namespace_id": "4316", "simple": { "limit": 120, "period": 60 } }
      ],
      // FROM_EMAIL remains the existing Worker secret: Localley <hello@localley.io>.
      // AUTH_EMAIL uses Cloudflare Email Sending. Auth no longer uses RESEND_API_KEY.
      "vars": {
        // Release a compatible readonly version before this active variant.
        // Rollback retains D1 rows and readability; never return to Source storage.
        "AUTH_NOTIFICATION_STORAGE": "active",
        // Override any preview-only default embedded by an OpenNext build.
        "SUPABASE_READ_ONLY": "false",
        "NEXTJS_ENV": "production",
        // Supabase exit: D1 serves since 2026-10-25 01:24Z (shared/plans/localley-supabase-exit.md). Rollback = gate 2 runbook.
        "DATA_BACKEND": "d1",
        "BETTER_AUTH_URL": "https://www.localley.io",
        "AUTH_ALLOWED_HOSTS": "www.localley.io,localley.io,next.localley.io"
      },
      // Cron Triggers ON since the DNS switch (P7/P8, Nils 2026-09-23); the Vercel crons were
      // disabled in the same window. Same UTC schedules as vercel.json (cloudflare/opennext/cron-routes.ts).
      "triggers": { "crons": ["0 3 * * *", "0 4 * * *", "23 2 1 * *", "0 5 * * *"] },
      // next.localley.io = production staging host (P5, approved by Nils 2026-09-23).
      // P7 (Nils 2026-09-23): localley.io and www.localley.io served here; the Vercel DNS records were deleted.
      "routes": [
        { "pattern": "next.localley.io", "custom_domain": true },
        { "pattern": "localley.io", "custom_domain": true },
        { "pattern": "www.localley.io", "custom_domain": true }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "enabled": true, "invocation_logs": true }
      }
    }
  }
}
